generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ספק ברירת מחדל: sqlite. ל-Postgres מקומי (docker compose) ראו README · npm run db:postgres:push

/// לקוחה או מנהלת · email ו/או phone, כמו בשדה ״טלפון או אימייל״ באפליקציה
model User {
  id           String   @id @default(cuid())
  role         String   @default("customer")
  email        String?  @unique
  phone        String?  @unique
  passwordHash String?
  googleId     String?  @unique
  name         String   @default("")
  address      String   @default("")
  city         String   @default("")
  note         String   @default("")
  /// נתיב מקומי או URL · POST /users/me/photo
  avatarUrl    String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders Order[]
  resets PasswordReset[]
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// הזמנה · סכומים בשקלים שלמים, בלי מע״מ (עוסק פטור)
model Order {
  id           String   @id @default(cuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  category     String
  status       String   @default("חדשה")
  name         String   @default("")
  phone        String   @default("")
  ship         String
  time         String
  city         String   @default("")
  address      String   @default("")
  pay          String
  saleDate     String   @default("")
  via          String   @default("")
  itemsJson    String
  detailsJson  String
  itemsTotal   Int
  shippingFee  Int      @default(0)
  total        Int
  cancelReason String   @default("")
  cancelNote   String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([category])
  @@index([createdAt])
  @@index([saleDate])
}

/// יום בלוח · חסימה, קטגוריית מכירה, מכסות ומנות שירדו
model SaleDay {
  date       String  @id
  blocked    Boolean @default(false)
  sale       String  @default("")
  exceptCat  String  @default("")
  open       Boolean @default(false)
  quotasJson String  @default("{}")
  wasteJson  String  @default("{}")
  updatedAt  DateTime @updatedAt
}

/// מלאי לוגיסטי · אריזות, יבשים וציוד. ידני, לא קשור למכירות
model SupplyItem {
  id        String   @id @default(cuid())
  groupName String
  name      String
  unit      String
  qty       Int      @default(0)
  min       Int      @default(0)
  per       Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// רשימת קניות · פתוחה אחת בכל רגע, סגורה נכנסת להיסטוריה ולהוצאות
model ShoppingList {
  id        String    @id @default(cuid())
  area      String
  openedAt  DateTime  @default(now())
  closedAt  DateTime?
  itemsJson String    @default("[]")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([closedAt])
  @@index([area])
}

/// מנת ייצור · מחיר ללקוחה, מתכון ומצב חישוב. מקור למסך התפריט
model ProductionDish {
  id        String   @id
  category  String
  sub       String   @default("")
  name      String
  mode      String
  price     Float
  yieldQty  Float    @default(0)
  note      String   @default("")
  fromJson  String   @default("[]")
  partsJson String   @default("[]")
  updatedAt DateTime @updatedAt
}

/// הוצאה לפי קטגוריית כספים · גם ידנית וגם מסגירת קנייה
model Expense {
  id        String   @id @default(cuid())
  category  String
  amount    Int
  period    String
  note      String   @default("")
  source    String   @default("")
  createdAt DateTime @default(now())

  @@index([period])
}
