generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ⚠ **עבר מ-SQLite ל-Postgres ב-19 בספטמבר 2026.**
//
// SQLite הוא קובץ אחד בלי כתיבה מקבילה: שתי לקוחות שמזמינות באותה
// שנייה נועלות זו את זו. זה החזיק בפיתוח ולא היה מחזיק באוויר.
//
// ⚠ **הסכימה זהה לחלוטין** · שום שדה לא השתנה במעבר. מה שכן
// השתנה: יש עכשיו **היסטוריית מיגרציות** תחת `prisma/migrations`
// במקום `db push`. `db push` משנה את המסד בלי תיעוד ויכול למחוק
// עמודה בלי לשאול — בפרודקשן זה לא מקובל.
//
// להרמת מסד מקומי: `npm run db:up` ואז `npm run db:migrate`.

/// לקוחה או מנהלת · email ו/או phone, כמו בשדה ״טלפון או אימייל״ באפליקציה
model User {
  id           String   @id @default(cuid())
  role         String   @default("customer")
  email        String?  @unique
  phone        String?  @unique
  passwordHash String?
  googleId     String?  @unique
  name         String   @default("")
  address      String   @default("")
  city         String   @default("")
  note         String   @default("")
  /// נתיב מקומי או URL · POST /users/me/photo
  avatarUrl    String   @default("")
  /// מגדר · "" כשלא נבחר · קובע אם פונים ללקוח או ללקוחה
  gender       String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders     Order[]
  resets     PasswordReset[]
  reminders  SaleReminder[]
  pushTokens PushToken[]
}

/// אסימון דחיפה של מכשיר · לשליחת התראה אמיתית לטלפון.
///
/// ⚠ **נוסף ב-18 בספטמבר 2026** · עד כה התזכורת הייתה **בתוך
/// האפליקציה** בלבד (החלטה של שקד מ-15 בספטמבר), והיא ביקשה
/// במפורש להוסיף התראה אמיתית: ״ברור שלהיכנס לזה זה חובה״.
///
/// ⚠ **אסימון למכשיר, לא למשתמשת** · לאותה לקוחה יכולים להיות כמה
/// מכשירים, ולכן המפתח הייחודי הוא האסימון עצמו. אותו מכשיר שמתחבר
/// עם חשבון אחר פשוט עובר בעלים.
model PushToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// אסימון Expo · "ExponentPushToken[...]"
  token     String   @unique
  platform  String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// בקשת תזכורת לפתיחת יום מכירה.
/// ההתראה מגיעה **בתוך האפליקציה** (החלטת שקד, 15 בספטמבר 2026):
/// כשיום המכירה של הקטגוריה נפתח, הלקוחה רואה שורת התראה בדף
/// הבית. `seenAt` מסמן שהיא כבר ראתה אותה, כדי שלא תחזור.
model SaleReminder {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  String
  createdAt DateTime  @default(now())
  /// התאריך שעליו כבר הוצגה התראה · ריק כל עוד לא הוצגה
  seenDate  String    @default("")

  @@unique([userId, category])
}

/// אימות טלפון **לפני** שיש חשבון.
///
/// ⚠ מוצמד למספר הטלפון ולא ל-`User`, וזו כל הסיבה שהטבלה הזו קיימת:
/// `PasswordReset` מחייבת `userId`, ובהרשמה עדיין אין משתמש לקשור
/// אליו. החוקים — תוקף, קירור וניסיונות — ב-`src/auth/phoneVerify.ts`.
model PhoneVerification {
  id         String    @id @default(cuid())
  /// בפורמט הבינלאומי · 972501234567
  phone      String    @unique
  code       String
  sentAt     DateTime  @default(now())
  expiresAt  DateTime
  /// ניסיונות הקלדה שנכשלו · נועל אחרי חמישה
  attempts   Int       @default(0)
  /// מתי הקוד אומת · זה מה שמתיר להשלים הרשמה
  verifiedAt DateTime?
  /// מתי האימות נוצל בפועל ליצירת חשבון
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([expiresAt])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// הקוד בן שש הספרות שנשלח במייל · ראו auth/resetCode.ts
  token     String    @unique
  expiresAt DateTime
  /// ניסיונות הקלדה שנכשלו · נועל אחרי חמישה, כמו באימות הטלפון
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// הזמנה · סכומים בשקלים שלמים, בלי מע״מ (עוסק פטור)
model Order {
  id           String   @id @default(cuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  category     String
  status       String   @default("חדשה")
  name         String   @default("")
  phone        String   @default("")
  ship         String
  time         String
  city         String   @default("")
  address      String   @default("")
  pay          String
  saleDate     String   @default("")
  via          String   @default("")
  itemsJson    String
  detailsJson  String
  itemsTotal   Int
  shippingFee  Int      @default(0)
  total        Int
  cancelReason String   @default("")
  cancelNote   String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([category])
  @@index([createdAt])
  @@index([saleDate])
}

/// יום בלוח · חסימה, קטגוריית מכירה, מכסות ומנות שירדו
model SaleDay {
  date       String  @id
  blocked    Boolean @default(false)
  sale       String  @default("")
  exceptCat  String  @default("")
  open       Boolean @default(false)
  quotasJson String  @default("{}")
  wasteJson  String  @default("{}")
  /// תיקון ידני למספר שנמכר · שקד מקלידה מספר והוא גובר על הספירה מההזמנות
  soldJson   String  @default("{}")
  /// מתי המכירה נפתחה בפעם הראשונה · מבדיל בין ״טרם נפתחה״ ל״נסגרה״
  openedAt   DateTime?
  updatedAt  DateTime @updatedAt
}

/// מלאי לוגיסטי · אריזות, יבשים וציוד. ידני, לא קשור למכירות
model SupplyItem {
  id        String   @id @default(cuid())
  groupName String
  name      String
  unit      String
  qty       Int      @default(0)
  min       Int      @default(0)
  per       Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// רשימת קניות · פתוחה אחת בכל רגע, סגורה נכנסת להיסטוריה ולהוצאות
model ShoppingList {
  id        String    @id @default(cuid())
  area      String
  openedAt  DateTime  @default(now())
  closedAt  DateTime?
  itemsJson String    @default("[]")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([closedAt])
  @@index([area])
}

/// מנת ייצור · מחיר ללקוחה, מתכון ומצב חישוב. מקור למסך התפריט
model ProductionDish {
  id        String   @id
  category  String
  sub       String   @default("")
  name      String
  mode      String
  price     Float
  yieldQty  Float    @default(0)
  note      String   @default("")
  fromJson  String   @default("[]")
  partsJson String   @default("[]")
  updatedAt DateTime @updatedAt
}

/// הוצאה לפי קטגוריית כספים · גם ידנית וגם מסגירת קנייה
/// הוצאה קבועה חודשית · תבנית שיוצרת שורת Expense בכל חודש
/// ראו server/src/admin/fixedExpenses.ts
model FixedExpense {
  id          String   @id @default(cuid())
  category    String
  amount      Int
  note        String   @default("")
  /// החודש הראשון שבו היא חלה · yyyy-mm
  fromPeriod  String
  /// החודש האחרון · מחרוזת ריקה = ממשיכה בלי סוף
  untilPeriod String   @default("")
  /// החודש האחרון שכבר נוצרה עבורו שורה · כדי שמחיקה ידנית תישאר מחוקה
  lastPeriod  String   @default("")
  createdAt   DateTime @default(now())
}

model Expense {
  id        String   @id @default(cuid())
  category  String
  amount    Int
  period    String
  note      String   @default("")
  source    String   @default("")
  createdAt DateTime @default(now())

  @@index([period])
}
