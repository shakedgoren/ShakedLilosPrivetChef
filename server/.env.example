# BITE & TELL · שרת מקומי
# העתיקי לקובץ `.env` בתיקייה הזו.

# --- מסד נתונים ---
# ⚠ **Postgres · עבר מ-SQLite ב-19.9.2026.** SQLite הוא קובץ אחד
# בלי כתיבה מקבילה — שתי לקוחות שמזמינות באותה שנייה נועלות זו את זו.
#
# מקומי, עם Docker:
#   npm run db:up        · מרים את הקונטיינר
#   npm run db:migrate   · מריץ את המיגרציות
#   npm run db:seed      · נתוני התחלה
# DATABASE_URL=

# בפרודקשן · הכתובת שהספק נותן
# DATABASE_URL=

PORT=3001
HOST=0.0.0.0

# חובה בפרודקשן · מחרוזת ארוכה ואקראית
JWT_SECRET="dev-change-me-bite-and-tell"

# תוקף הטוקן בשעות
JWT_EXPIRES_HOURS=

# מאחורי פרוקסי (nginx / Render / Fly) · כמה שכבות לסמוך עליהן.
# חובה בפרודקשן, אחרת הגבלת הקצב רואה את כולם כאותה כתובת.
# TRUST_PROXY=1168

# חשבון הניהול שנוצר ב-`npm run db:seed`
ADMIN_EMAIL="shaked@localhost"
ADMIN_PHONE="0500000000"
ADMIN_PASSWORD="changeme"
ADMIN_NAME="שקד לילוז"

# התחברות עם גוגל · POST /auth/google עם { "idToken": "<Google ID token>" }
# אפשר כמה מזהי לקוח מופרדים בפסיק (Web / iOS / Android).
# בלי המשתנה ההתחברות מחזירה 501 google_not_configured.
# GOOGLE_CLIENT_ID="123.apps.googleusercontent.com"

# תיקיית העלאות מקומית (תמונת פרופיל) · מוגשת ב-/uploads
# UPLOAD_DIR="./uploads"

# בפיתוח בלבד: POST /auth/forgot-password מחזיר את הטוקן בגוף התשובה
RESET_DEBUG=1

# --- מייל (איפוס סיסמה) ---
# בלי SMTP_HOST / SMTP_USER / SMTP_PASS / MAIL_FROM לא נשלח כלום, השרת רץ.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_USER=""
# SMTP_PASS=""
# MAIL_FROM="BITE & TELL <no-reply@example.com>"
# APP_URL="http://localhost:8081"

# --- WhatsApp Cloud API (ישירות מול Meta, בלי BSP) ---
# בלי TOKEN + PHONE_NUMBER_ID השרת רץ כרגיל והשליחות מדולגות.
# הוראות חיבור מלאות ב-README.md (סעיף WhatsApp).
# מספר מחובר: +972 52-505-6708
# הטוקן לא נכנס לגיט — רק ב-.env מקומי או ב-Railway Variables.
# WHATSAPP_TOKEN="EAAG..."
# WHATSAPP_PHONE_NUMBER_ID="1318024191397722"
# WHATSAPP_WABA_ID="1753798195905322"
# WHATSAPP_TEMPLATE_OTP="bite_otp"
# שמות התבניות כפי שאושרו ב-Meta · כולל שגיאות הכתיב (dely / dalivery)
# WHATSAPP_TEMPLATE_ORDER_CONFIRMED_PICKUP="order_pickup_confirmed"
# WHATSAPP_TEMPLATE_ORDER_CONFIRMED_DELIVERY="order_dely"
# WHATSAPP_TEMPLATE_ORDER_READY_PICKUP="order_pick_up"
# WHATSAPP_TEMPLATE_ORDER_DELIVERED="order_dalivery"
# WHATSAPP_TEMPLATE_LANG="he"
# WHATSAPP_GRAPH_VERSION="v21.0"
# WHATSAPP_WEBHOOK_VERIFY_TOKEN="choose-a-long-random-string"
