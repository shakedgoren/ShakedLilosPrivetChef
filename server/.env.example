# BITE & TELL · שרת מקומי
# העתיקי לקובץ `.env` בתיקייה הזו.

# SQLite מקומי (ברירת מחדל). לפרודקשן אפשר Postgres:
# DATABASE_URL="postgresql://user:pass@localhost:5432/biteandtell?schema=public"
DATABASE_URL="file:./dev.db"

PORT=3001
HOST=0.0.0.0

# חובה בפרודקשן · מחרוזת ארוכה ואקראית
JWT_SECRET="dev-change-me-bite-and-tell"

# תוקף הטוקן בשעות
JWT_EXPIRES_HOURS=168

# חשבון הניהול שנוצר ב-`npm run db:seed`
ADMIN_EMAIL="shaked@localhost"
ADMIN_PHONE="0500000000"
ADMIN_PASSWORD="changeme"
ADMIN_NAME="שקד לילוז"

# אם מוגדר — POST /auth/google יאמת idToken מול Google.
# בלי זה ההתחברות עם גוגל מחזירה 501 (stub).
# GOOGLE_CLIENT_ID=""

# בפיתוח בלבד: POST /auth/forgot-password מחזיר את הטוקן בגוף התשובה
RESET_DEBUG=1
