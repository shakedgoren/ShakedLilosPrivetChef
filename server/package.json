{
  "name": "bite-and-tell-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:postgres:up": "docker compose up -d",
    "db:postgres:down": "docker compose down",
    "db:postgres:push": "node scripts/db-mode.mjs push",
    "postinstall": "prisma generate",
    "smoke": "tsx scripts/smoke.ts",
    "test": "tsx --test src/catalog/quote.test.ts src/admin/saleWeek.test.ts src/admin/prices.test.ts src/admin/expenseCats.test.ts src/admin/manualOrderWa.test.ts src/admin/apiMethods.test.ts src/orders/saleDay.test.ts src/auth/google.test.ts src/mail/resetEmail.test.ts src/mail/mailer.test.ts src/whatsapp/payloads.test.ts src/whatsapp/client.test.ts src/auth/phoneVerify.test.ts src/push/expo.test.ts src/http/page.test.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.15.0",
    "@types/nodemailer": "^8.0.2",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "google-auth-library": "^11.0.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.3.0",
    "nodemailer": "^10.0.10",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.3.1",
    "prisma": "^6.15.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
