{
  "expo": {
    "name": "BITE & TELL",
    "slug": "bite-and-tell",
    "scheme": ["bitetell", "com.biteandtell.app"],
    "version": "1.0.0",
    "_orientationNote": "⚠ היה portrait · נפתח ל-default ב-18.9.2026 כדי שלוח יום המכירה יוכל להסתובב עם המכשיר. כל שאר המסכים ננעלים לזקוף ב-RootNavigator — iOS חותך את בקשת המסך מול מה שה-Info.plist מתיר, ולכן הפתיחה כאן הכרחית.",
  "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "ExpoLocalization_supportsRTL": true,
        "NSFaceIDUsageDescription": "כדי לאפשר לך להיכנס לחשבון במהירות ובאופן מאובטח באמצעות Face ID.",
        "ExpoLocalization_forcesRTL": true,
        "CFBundleLocalizations": [
          "he"
        ]
      },
      "bundleIdentifier": "com.biteandtell.app",
      "buildNumber": "1",
      "requireFullScreen": true
    },
    "android": {
      "package": "com.biteandtell.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "forcesRTL": true,
          "supportedLocales": [
            "he"
          ]
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-notifications"
    ]
  }
}
